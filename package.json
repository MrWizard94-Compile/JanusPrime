{
  "name": "janusprime",
  "version": "1.0.0",
  "private": true,
  "description": "JanusPrime — unified autonomous development and asset generation system",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrWizard94-Compile/JanusPrime.git"
  },
  "scripts": {
    "build": "pnpm --dir Project-Janus build",
    "test": "pnpm --dir Project-Janus test",
    "typecheck": "pnpm --dir Project-Janus typecheck",
    "lint": "pnpm --dir Project-Janus lint",
    "janus": "pnpm --dir Project-Janus aether",
    "memory:up": "docker compose up -d",
    "memory:down": "docker compose down",
    "memory:logs": "docker compose logs -f memory",
    "assets:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-assetconverter.ps1"
  }
}