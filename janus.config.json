{
  "version": "1.0.0",
  "name": "janusprime",
  "description": "JanusPrime â€” unified autonomous development and asset generation system",
  "components": {
    "orchestrator": {
      "root": "Project-Janus",
      "state_dir": ".aether"
    },
    "memory": {
      "root": "Smart-Library",
      "url": "http://localhost:8000",
      "api_key_env": "JANUS_MEMORY_API_KEY",
      "context_limit": 3,
      "max_context_chars": 8000
    },
    "assets": {
      "root": "../AssetConverter",
      "entry": "ac.py",
      "python": "python"
    },
    "cognition": {
      "root": "env:REL_COGNITION_ROOT",
      "rest_url": "http://localhost:8080",
      "api_key_env": "JANUS_REL_API_KEY",
      "bearer_token_env": "JANUS_REL_BEARER_TOKEN",
      "log_loop_outcomes": true,
      "sync_concepts_to_memory": true,
      "concept_sync_max_chars": 2000
    }
  },
  "executor": {
    "primary": "grok",
    "fallback": "qwen",
    "providers": {
      "grok": {
        "type": "grok-cli",
        "command": "grok",
        "model": "grok-build",
        "headless": true,
        "permission_mode": "bypassPermissions",
        "output_format": "json"
      },
      "qwen": {
        "type": "ollama",
        "base_url": "http://localhost:11434/v1",
        "model": "qwen2.5-coder:7b",
        "max_repair_rounds": 3
      }
    }
  },
  "self_repair": {
    "max_validation_retries": 5,
    "max_heal_attempts": 3,
    "seed_on_accept": true,
    "seed_on_heal": true
  },
  "token_policy": {
    "brief_max_chars": 12000,
    "memory_slice_max_chars": 2000,
    "resolved_context_max_chars": 3000,
    "validation_error_max": 20,
    "rel_context_max_chars": 800
  },
  "doctrine": {
    "claude_path": "CLAUDE.md",
    "inject_into_brief": true,
    "inject_into_mcp_instructions": true,
    "seed_on_boot": false,
    "brief_excerpt_max_chars": 4000,
    "mcp_instruction_excerpt_max_chars": 1500
  }
}