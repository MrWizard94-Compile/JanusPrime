# JanusPrime docker-compose overrides

# Path to REL repo for cognition service build (default assumes sibling checkout)
REL_BUILD_CONTEXT=C:/REL_Codex_Variant

# Host path for REL persistent data volume
REL_DATA_PATH=C:/REL_Codex_Variant/data

# REL REST API auth (local dev — disable for frictionless bridge testing)
REL_API_AUTH_REQUIRED=false
REL_ADMIN_PASSWORD=change-me-local-dev
REL_OAUTH2_SECRET=change-me-local-dev-secret-min-32-chars

# JanusPrime → REL bridge credentials (create API key via REL admin when auth enabled)
# JANUS_REL_API_KEY=rel_...
# JANUS_REL_BEARER_TOKEN=...