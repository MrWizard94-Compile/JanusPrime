# JanusPrime docker-compose environment
#
# REQUIRED before `docker compose up`:
#   cp .env.example .env
#   Edit .env with your local paths and secrets (compose will fail without REL_* secrets below).

# Path to REL repo for cognition service build (default assumes sibling checkout)
REL_BUILD_CONTEXT=C:/REL_Codex_Variant

# Janus cognition component root (janus.config.json cognition.root via env:REL_COGNITION_ROOT)
# Often the same path as REL_BUILD_CONTEXT
REL_COGNITION_ROOT=C:/REL_Codex_Variant

# Host path for REL persistent data volume
REL_DATA_PATH=C:/REL_Codex_Variant/data

# REL REST API auth (local dev — disable for frictionless bridge testing)
REL_API_AUTH_REQUIRED=false
REL_ADMIN_USERNAME=admin

# Required — compose uses ${VAR:?error} and will not start without these set in .env
REL_ADMIN_PASSWORD=change-me-local-dev
REL_OAUTH2_SECRET=change-me-local-dev-secret-min-32-chars

# Smart-Library write API key (optional for local dev; set to enable X-API-Key on /seed, /execute-heal, etc.)
# Janus orchestrator reads JANUS_MEMORY_API_KEY; compose maps it to memory service API_KEY.
JANUS_MEMORY_API_KEY=
# API_KEY=  # alternative name; used only if JANUS_MEMORY_API_KEY is unset

# JanusPrime → REL bridge credentials (create API key via REL admin when auth enabled)
# JANUS_REL_API_KEY=rel_...
# JANUS_REL_BEARER_TOKEN=...